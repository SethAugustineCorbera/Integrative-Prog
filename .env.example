# Copy this file to .env and replace every placeholder before starting the API.
FLASK_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-characters
HUB_HMAC_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
HUB_SLIP_SIGNING_KEY=replace-with-another-different-random-secret-of-at-least-32

# XAMPP MySQL defaults. Import database/schema.sql in phpMyAdmin first.
DB_MODE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=dnsc_clearance_hub
DB_USER=root
DB_PASSWORD=

HUB_HOST=127.0.0.1
HUB_PORT=8000
HUB_DEBUG=false
FRONTEND_ORIGINS=http://localhost,http://127.0.0.1

# Optional HTTPS certificate paths for a direct TLS deployment.
# Leave both empty for local HTTP. Prefer a managed reverse proxy for production.
HUB_SSL_CERT=
HUB_SSL_KEY=

# Set these from the course-approved Registrar service or the local mock.
REGISTRAR_API_URL=http://127.0.0.1:8001/api/v1
REGISTRAR_API_KEY=replace-with-the-course-approved-registrar-key
HOLIDAYS_COUNTRY=PH
CLEARANCE_WORKING_DAYS=15

# Optional local-only demo account password. Do not reuse a real password.
DEMO_PASSWORD=
DROP_FOLDER=drop_folder
ARCHIVE_FOLDER=archive
LOG_FOLDER=logs
REPORT_FOLDER=reports
